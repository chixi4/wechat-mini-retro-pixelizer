<wxs module="grid" src="./grid.wxs"></wxs>
<view class="page {{themeClass}} {{isIPad ? 'is-ipad' : ''}}" style="--safe-top: {{safeTopPx}}px; --safe-bottom: {{safeBottomPx}}px;">
  <view class="safe-top-mask"></view>
  <view
    class="header {{headerVisible ? 'visible' : ''}}"
    id="headerRef"
    style="--nav-pad-left: {{navPadLeftPx}}px; --nav-pad-right: {{navPadRightPx}}px;"
  >
    <view class="title">Retro Pixelizer</view>
  </view>

  <view class="main {{hasImage ? 'has-image' : ''}}" id="mainContainer">
    <scroll-view
      class="controls"
      scroll-y
      enable-flex
      scroll-with-animation="false"
      scroll-top="{{controlsScrollTop}}"
      bindscroll="onControlsScroll"
      bindtouchstart="onControlsTouchStart"
      bindtouchmove="onControlsTouchMove"
      bindtouchend="onControlsTouchEnd"
      style="padding-top: {{controlsPaddingTopPx}}px;"
    >
      <view class="controls-inner {{layoutAnimEnabled ? 'layout-anim' : ''}}" style="transform: translateY({{controlsShiftPx}}px);">
        <view class="panel">
          <view class="panel-title panel-title--switch">
            <view class="panel-title-label {{inputMode === 'camera' ? 'is-inactive' : 'is-active'}}">上传图片</view>
            <view class="panel-title-label {{inputMode === 'camera' ? 'is-active' : 'is-inactive'}}">相机模式</view>
          </view>
          <view class="upload-area upload-area--swiper">
            <swiper
              class="upload-swiper"
              current="{{inputSwiperIndex}}"
              duration="240"
              circular="false"
              skip-hidden-item-layout
              bindchange="onInputSwiperChange"
              bindanimationfinish="onInputSwiperAnimationFinish"
            >
              <swiper-item>
                <view class="upload-slide upload-slide--tap" bindtap="onChooseImage">
                  <view class="upload-text">
                    <view>点击上传图片</view>
                    <view>〈〈 左滑进入相机模式</view>
                  </view>
                </view>
              </swiper-item>
              <swiper-item>
                <view class="upload-slide" bindtap="onCameraCaptureTap">
                  <view class="upload-text">
                    <view>点击拍摄</view>
                    <view>或点击预览窗也可以拍摄</view>
                  </view>
                  <view
                    wx:if="{{cameraState === 'denied' || cameraState === 'unsupported' || cameraState === 'error'}}"
                    class="camera-cta-row"
                  >
                    <view
                      wx:if="{{cameraState === 'denied'}}"
                      class="btn-ghost"
                      catchtap="onOpenCameraSetting"
                    >去设置开启相机权限</view>
                    <view
                      wx:elif="{{cameraState === 'unsupported'}}"
                      class="btn-ghost"
                      catchtap="onChooseImage"
                    >不支持实时相机，改用拍照上传</view>
                    <view
                      wx:elif="{{cameraState === 'error'}}"
                      class="btn-ghost"
                      catchtap="onRetryCamera"
                    >重试启动相机</view>
                  </view>
                </view>
              </swiper-item>
            </swiper>
          </view>
        </view>

        <view class="panel">
          <view class="panel-title">
            <view>图像预处理</view>
          </view>

          <view class="form-group">
            <view class="label-row">
              <view class="label">图片像素</view>
              <view class="width-display">{{targetWidth}}px</view>
            </view>

            <view
              class="custom-slider"
              id="widthSliderContainer"
              bindtap="onSliderTap"
              catchtouchstart="onSliderTouchStart"
              catchtouchmove="onSliderTouchMove"
              bindtouchend="onSliderTouchEnd"
              bindtouchcancel="onSliderTouchEnd"
            >
              <view class="slider-track"></view>
              <view class="slider-thumb {{sliderDragging ? 'active' : ''}}" style="left: {{sliderThumbLeftPx}}px;">
                <view class="slider-thumb-dot"></view>
              </view>
            </view>
          </view>

          <view class="form-group">
            <view class="label-row">
              <view class="label">影调调色台</view>
              <view class="reset-btn" bindtap="onResetTone">↺ 重置</view>
            </view>
            <view
              class="xy-pad-container"
              id="xyPadContainer"
              catchtouchstart="onXYTouchStart"
              catchtouchmove="onXYTouchMove"
              bindtouchend="onXYTouchEnd"
              bindtouchcancel="onXYTouchEnd"
            >
              <view class="xy-grid">
                <view
                  wx:for="{{gridPoints}}"
                  wx:key="id"
                  class="grid-point"
                  style="{{grid.pointStyle(item, gridCursorX, gridCursorY)}}"
                >
                  <view class="grid-point-h"></view>
                  <view class="grid-point-v"></view>
                </view>
              </view>
            </view>
          </view>
        </view>

        <view class="panel">
          <view class="panel-title">纹理风格</view>
          <view class="grid-buttons">
            <view
              wx:for="{{ditherAlgos}}"
              wx:key="key"
              class="btn-toggle {{ditherAlgo === item.key ? 'active' : ''}}"
              data-key="{{item.key}}"
              bindtap="onSelectDither"
            >{{item.label}}</view>
          </view>
        </view>

        <view class="panel palette-panel">
          <view class="panel-title">
            <view>调色板</view>
          </view>
          <scroll-view
            class="palette-list"
            id="paletteList"
            scroll-y
            scroll-top="{{paletteScrollTop}}"
            scroll-with-animation="true"
          >
            <view
              wx:for="{{paletteList}}"
              wx:key="key"
              id="palette-{{item.key}}"
              class="palette-btn {{paletteKey === item.key ? 'active' : ''}}"
              data-key="{{item.key}}"
              bindtap="onSelectPalette"
            >
              <view class="palette-name-row">
                <view class="palette-name">{{item.name}}</view>
                <view class="palette-count">{{item.count}}色</view>
              </view>
              <view class="palette-preview-dots">
                <view
                  wx:for="{{item.colors}}"
                  wx:key="*this"
                  class="dot"
                  style="background-color: {{item}};"
                ></view>
              </view>
            </view>
          </scroll-view>
        </view>

        <view class="panel">
          <view class="action-btn {{canDownload ? '' : 'disabled'}}" bindtap="onDownload">下载图片</view>
        </view>

        <view class="bottom-spacer" style="height: {{safeBottomPx}}px;"></view>
      </view>
    </scroll-view>

    <view class="preview-area {{layoutAnimEnabled ? 'layout-anim' : ''}}" style="--preview-h: {{previewHeightPx}}px; --preview-shift: {{previewTranslateYPx}}px; transform: translateY({{previewShiftPx}}px);">
      <view class="canvas-container {{(fullscreenVisible || fullscreenClosing) ? 'fullscreen-transition' : ''}}" id="canvasContainer">
        <view
          class="preview-shot {{cameraCaptureActive ? 'is-capturing' : ''}}"
          style="width: {{mainCanvasCssW}}px; height: {{mainCanvasCssH}}px;"
        >
          <canvas
            type="2d"
            id="mainCanvas"
            class="main-canvas {{useGLPreview ? 'offscreen-canvas' : ''}} {{((fullscreenActive || fullscreenClosing) && !previewHoldVisible) ? 'is-hidden' : ''}}"
            style="width: {{mainCanvasCssW}}px; height: {{mainCanvasCssH}}px;"
            bindtap="onPreviewTap"
          ></canvas>
          <canvas
            type="webgl"
            id="mainGLCanvas"
            class="main-canvas {{!useGLPreview ? 'offscreen-canvas' : ''}} {{((fullscreenActive || fullscreenClosing) && !previewHoldVisible) ? 'is-hidden' : ''}}"
            style="width: {{mainCanvasCssW}}px; height: {{mainCanvasCssH}}px;"
            bindtap="onPreviewTap"
          ></canvas>
          <view class="camera-capture {{cameraCaptureActive ? 'active' : ''}}">
            <view class="camera-capture-flash"></view>
            <view class="camera-capture-vignette"></view>
          </view>
        </view>
        <view class="camera-fade {{cameraFadeVisible ? 'visible' : ''}}"></view>
        <view wx:if="{{!hasImage}}" class="empty-hint">点击左侧上传图片</view>
      </view>

      <view
        wx:if="{{hasImage}}"
        class="close-btn {{closeEnabled ? 'enabled' : ''}} {{closeShown ? 'shown' : ''}} {{(!isIPad && fullscreenVisible) ? 'is-hidden' : ''}}"
        catchtap="onCloseImage"
      >
        <view class="close-btn-icon">
          <view class="close-btn-line line-a"></view>
          <view class="close-btn-line line-b"></view>
        </view>
      </view>

      <canvas type="2d" id="workCanvas" class="hidden-canvas"></canvas>
      <canvas type="2d" id="bufferCanvas" class="hidden-canvas"></canvas>
      <canvas type="2d" id="exportCanvas" class="hidden-canvas"></canvas>
      <canvas type="2d" id="fullscreenCanvas" class="hidden-canvas"></canvas>
      <camera
        wx:if="{{cameraVisible}}"
        id="camera"
        class="camera-offscreen"
        device-position="back"
        resolution="low"
        flash="off"
        binderror="onCameraError"
      ></camera>
    </view>

  </view>

  <view
    wx:if="{{fullscreenVisible || fullscreenClosing}}"
    class="fullscreen-modal {{fullscreenActive ? 'active' : ''}} {{fullscreenClosing ? 'closing' : ''}} {{fullscreenAnimating ? 'animating' : ''}}"
  >
    <view class="fullscreen-backdrop" catchtap="onCloseFullscreen"></view>
    <view class="fullscreen-stage">
      <canvas
        wx:if="{{!useGLPreview}}"
        type="2d"
        id="fullscreenViewCanvas"
        class="fullscreen-image"
        bindtouchstart="onFullscreenTouchStart"
        bindtouchmove="onFullscreenTouchMove"
        bindtouchend="onFullscreenTouchEnd"
        bindtap="onFullscreenTap"
        style="left: {{fullscreenImageLeft}}px; top: {{fullscreenImageTop}}px; width: {{fullscreenImageW}}px; height: {{fullscreenImageH}}px; transform: translate3d({{fullscreenTranslateX}}px, {{fullscreenTranslateY}}px, 0) scale({{fullscreenScale}});"
      ></canvas>
      <image
        wx:else
        class="fullscreen-image"
        src="{{fullscreenSrc}}"
        mode="aspectFit"
        bindload="onFullscreenImageLoad"
        binderror="onFullscreenImageError"
        bindtouchstart="onFullscreenTouchStart"
        bindtouchmove="onFullscreenTouchMove"
        bindtouchend="onFullscreenTouchEnd"
        bindtap="onFullscreenTap"
        style="left: {{fullscreenImageLeft}}px; top: {{fullscreenImageTop}}px; width: {{fullscreenImageW}}px; height: {{fullscreenImageH}}px; transform: translate3d({{fullscreenTranslateX}}px, {{fullscreenTranslateY}}px, 0) scale({{fullscreenScale}});"
      ></image>
    </view>
  </view>

</view>
