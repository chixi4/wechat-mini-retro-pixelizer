<wxs module="grid" src="./grid.wxs"></wxs>
<view class="page {{themeClass}} {{isIPad ? 'is-ipad' : ''}}" style="--safe-top: {{safeTopPx}}px; --safe-bottom: {{safeBottomPx}}px;">
  <view class="safe-top-mask"></view>
  <view
    class="header {{headerVisible ? 'visible' : ''}}"
    id="headerRef"
    style="--nav-pad-left: {{navPadLeftPx}}px; --nav-pad-right: {{navPadRightPx}}px;"
  >
    <view class="title">Retro Pixelizer</view>
  </view>

  <view class="main {{hasImage ? 'has-image' : ''}}" id="mainContainer">
    <scroll-view
      class="controls"
      scroll-y
      enable-flex
      scroll-with-animation="false"
      scroll-top="{{controlsScrollTop}}"
      bindscroll="onControlsScroll"
      bindtouchstart="onControlsTouchStart"
      bindtouchmove="onControlsTouchMove"
      bindtouchend="onControlsTouchEnd"
      style="padding-top: {{controlsPaddingTopPx}}px;"
    >
      <view class="controls-inner {{layoutAnimEnabled ? 'layout-anim' : ''}}" style="transform: translateY({{controlsShiftPx}}px);">
        <view class="panel">
          <view class="panel-title">上传图片</view>
          <view class="upload-area" bindtap="onChooseImage">
            <view class="upload-text">点击或拖拽上传
支持 JPG, PNG</view>
          </view>
        </view>

        <view class="panel">
          <view class="panel-title">
            <view>图像预处理</view>
          </view>

          <view class="form-group">
            <view class="label-row">
              <view class="label">图片像素</view>
              <view class="width-display">{{targetWidth}}px</view>
            </view>

            <view
              class="custom-slider"
              id="widthSliderContainer"
              bindtap="onSliderTap"
              catchtouchstart="onSliderTouchStart"
              catchtouchmove="onSliderTouchMove"
              bindtouchend="onSliderTouchEnd"
              bindtouchcancel="onSliderTouchEnd"
            >
              <view class="slider-track"></view>
              <view class="slider-thumb {{sliderDragging ? 'active' : ''}}" style="left: {{sliderThumbLeftPx}}px;">
                <view class="slider-thumb-dot"></view>
              </view>
            </view>
          </view>

          <view class="form-group">
            <view class="label-row">
              <view class="label">影调调色台</view>
              <view class="reset-btn" bindtap="onResetTone">↺ 重置</view>
            </view>
            <view
              class="xy-pad-container"
              id="xyPadContainer"
              catchtouchstart="onXYTouchStart"
              catchtouchmove="onXYTouchMove"
              bindtouchend="onXYTouchEnd"
              bindtouchcancel="onXYTouchEnd"
            >
              <view class="xy-grid">
                <view
                  wx:for="{{gridPoints}}"
                  wx:key="id"
                  class="grid-point"
                  style="{{grid.pointStyle(item, gridCursorX, gridCursorY)}}"
                >
                  <view class="grid-point-h"></view>
                  <view class="grid-point-v"></view>
                </view>
              </view>
            </view>
          </view>
        </view>

        <view class="panel">
          <view class="panel-title">纹理风格</view>
          <view class="grid-buttons">
            <view
              wx:for="{{ditherAlgos}}"
              wx:key="key"
              class="btn-toggle {{ditherAlgo === item.key ? 'active' : ''}}"
              data-key="{{item.key}}"
              bindtap="onSelectDither"
            >{{item.label}}</view>
          </view>
        </view>

        <view class="panel palette-panel">
          <view class="panel-title">
            <view>调色板</view>
          </view>
          <scroll-view class="palette-list" scroll-y>
            <view
              wx:for="{{paletteList}}"
              wx:key="key"
              class="palette-btn {{paletteKey === item.key ? 'active' : ''}}"
              data-key="{{item.key}}"
              bindtap="onSelectPalette"
            >
              <view class="palette-name-row">
                <view class="palette-name">{{item.name}}</view>
                <view class="palette-count">{{item.count}}色</view>
              </view>
              <view class="palette-preview-dots">
                <view
                  wx:for="{{item.colors}}"
                  wx:key="*this"
                  class="dot"
                  style="background-color: {{item}};"
                ></view>
              </view>
            </view>
          </scroll-view>
        </view>

        <view class="panel">
          <view class="action-btn {{canDownload ? '' : 'disabled'}}" bindtap="onDownload">下载图片</view>
        </view>

        <view class="bottom-spacer" style="height: {{safeBottomPx}}px;"></view>
      </view>
    </scroll-view>

    <view class="preview-area {{layoutAnimEnabled ? 'layout-anim' : ''}}" style="--preview-h: {{previewHeightPx}}px; --preview-shift: {{previewTranslateYPx}}px; transform: translateY({{previewShiftPx}}px);">
      <view class="canvas-container" id="canvasContainer">
        <canvas
          type="2d"
          id="mainCanvas"
          class="main-canvas {{useGLPreview ? 'offscreen-canvas' : ''}} {{(fullscreenActive || fullscreenClosing) ? 'is-hidden' : ''}}"
          style="width: {{mainCanvasCssW}}px; height: {{mainCanvasCssH}}px;"
          bindtap="onOpenFullscreen"
        ></canvas>
        <canvas
          type="webgl"
          id="mainGLCanvas"
          class="main-canvas {{!useGLPreview ? 'offscreen-canvas' : ''}} {{(fullscreenActive || fullscreenClosing) ? 'is-hidden' : ''}}"
          style="width: {{mainCanvasCssW}}px; height: {{mainCanvasCssH}}px;"
          bindtap="onOpenFullscreen"
        ></canvas>
        <view wx:if="{{!hasImage}}" class="empty-hint">点击左侧上传图片</view>
      </view>

      <view
        wx:if="{{hasImage}}"
        class="close-btn {{closeEnabled ? 'enabled' : ''}} {{closeShown ? 'shown' : ''}} {{fullscreenVisible ? 'is-hidden' : ''}}"
        catchtap="onCloseImage"
      >
        <view class="close-btn-icon">
          <view class="close-btn-line line-a"></view>
          <view class="close-btn-line line-b"></view>
        </view>
      </view>

      <canvas type="2d" id="workCanvas" class="hidden-canvas"></canvas>
      <canvas type="2d" id="bufferCanvas" class="hidden-canvas"></canvas>
      <canvas type="2d" id="exportCanvas" class="hidden-canvas"></canvas>
    </view>

  </view>

  <view
    wx:if="{{fullscreenVisible || fullscreenClosing}}"
    class="fullscreen-modal {{fullscreenActive ? 'active' : ''}} {{fullscreenClosing ? 'closing' : ''}} {{fullscreenAnimating ? 'animating' : ''}}"
  >
    <view class="fullscreen-backdrop" catchtap="onCloseFullscreen"></view>
    <view class="fullscreen-stage">
      <image
        class="fullscreen-image"
        src="{{fullscreenSrc}}"
        mode="aspectFit"
        bindtouchstart="onFullscreenTouchStart"
        bindtouchmove="onFullscreenTouchMove"
        bindtouchend="onFullscreenTouchEnd"
        bindtap="onFullscreenTap"
        style="left: {{fullscreenImageLeft}}px; top: {{fullscreenImageTop}}px; width: {{fullscreenImageW}}px; height: {{fullscreenImageH}}px; transform: translate({{fullscreenTranslateX}}px, {{fullscreenTranslateY}}px) scale({{fullscreenScale}});"
      ></image>
    </view>
  </view>

</view>
