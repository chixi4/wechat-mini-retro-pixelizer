.page {
  max-width: 1400px;
  margin: 0 auto;
  height: 100%;
  display: flex;
  flex-direction: column;
  background: #ffffff;
  color: #000000;
}

.page.theme-dark {
  background: #111111;
  color: #eeeeee;
}

.header {
  display: flex;
  justify-content: flex-start;
  align-items: center;
  padding: 15px var(--nav-pad-right, 20px) 15px var(--nav-pad-left, 20px);
  border-bottom: 2px solid #000000;
  flex-shrink: 0;
  background: #ffffff;
  z-index: 20;
}

.theme-dark .header {
  border-bottom-color: #666666;
  background: #111111;
}

.title {
  font-size: 26px;
  font-weight: 900;
  letter-spacing: -0.5px;
  text-align: left;
  position: relative;
  top: 1px;
}

.safe-top-mask {
  display: none;
}


.main {
  display: grid;
  grid-template-columns: 340px 1fr;
  gap: 24px;
  flex: 1;
  overflow: hidden;
  padding: 20px;
  box-sizing: border-box;
}

.controls {
  height: 100%;
  overflow-y: auto;
}

.controls-inner {
  display: flex;
  flex-direction: column;
  gap: 16px;
  min-height: 100%;
}

.preview-area {
  position: relative;
  height: 100%;
  width: 100%;
  overflow: hidden;
  display: flex;
  justify-content: center;
  align-items: center;
  z-index: 1;
}

.preview-area.is-hidden {
  opacity: 0;
  pointer-events: none;
  visibility: hidden;
}

.main.has-image .preview-area.is-hidden {
  opacity: 0;
  pointer-events: none;
  visibility: hidden;
}

.panel {
  border: 2px solid #000000;
  padding: 16px;
  background: #f5f5f5;
  flex-shrink: 0;
}

/* 纵向相邻模块的边框避免叠加成“双倍粗” */
.panel + .panel {
  margin-top: -2px;
}

.theme-dark .panel {
  border-color: #666666;
  background: #1a1a1a;
}

.panel-title {
  font-weight: 800;
  margin-bottom: 10px;
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.upload-area {
  border: 2px dashed #000000;
  padding: 18px;
  display: flex;
  justify-content: center;
  align-items: center;
  min-height: 100px;
  background: #ffffff;
}

.theme-dark .upload-area {
  border-color: #666666;
  background: #111111;
}

.upload-text {
  font-size: 12px;
  color: #666666;
  text-align: center;
  white-space: pre-line;
}

.theme-dark .upload-text {
  color: #888888;
}

.form-group {
  margin-top: 12px;
}

.label-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 6px;
}

.width-display {
  font-size: 12px;
  font-weight: 700;
}

.custom-slider {
  position: relative;
  width: 100%;
  height: 30px;
  display: flex;
  align-items: center;
  margin: 5px 0;
}

.slider-track {
  position: absolute;
  left: 0;
  right: 0;
  height: 6px;
  background: #000000;
  border-radius: 3px;
}

.theme-dark .slider-track {
  background: #666666;
}

.slider-thumb {
  position: absolute;
  left: 0;
  width: 28px;
  height: 28px;
  margin-left: -14px;
  background: transparent;
  z-index: 2;
  display: flex;
  justify-content: center;
  align-items: center;
}

.slider-thumb-dot {
  width: 16px;
  height: 16px;
  background: #000000;
  border: 2px solid #ffffff;
  border-radius: 50%;
  transform: scale(1);
  transition: transform 0.1s;
}

.theme-dark .slider-thumb-dot {
  background: #eeeeee;
}

.theme-dark .slider-thumb-dot {
  border-color: #111111;
}

.slider-thumb.active .slider-thumb-dot {
  transform: scale(1.2);
}

.xy-pad-container {
  position: relative;
  width: 100%;
  height: 140px;
  background: #ffffff;
  border: 2px solid #000000;
  overflow: hidden;
  margin-bottom: 8px;
  touch-action: pan-y;
}

.theme-dark .xy-pad-container {
  border-color: #666666;
  background: #111111;
}

.xy-grid {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  pointer-events: none;
}

.grid-point {
  position: absolute;
  transform: translate(-50%, -50%);
  pointer-events: none;
  width: 6px;
  height: 6px;
  opacity: 0.15;
  --t: 1px;
}

.grid-point-h,
.grid-point-v {
  position: absolute;
  background: #000000;
}

.grid-point-h {
  left: 0;
  right: 0;
  top: 50%;
  height: var(--t, 1px);
  transform: translateY(-50%);
}

.grid-point-v {
  top: 0;
  bottom: 0;
  left: 50%;
  width: var(--t, 1px);
  transform: translateX(-50%);
}

.theme-dark .grid-point-h,
.theme-dark .grid-point-v {
  background: #eeeeee;
}

.reset-btn {
  font-size: 12px;
  border: 1px solid #000000;
  padding: 2px 8px;
}

.theme-dark .reset-btn {
  border-color: #666666;
}

.grid-buttons {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 8px;
}

.btn-toggle {
  background: #ffffff;
  border: 1px solid #000000;
  color: #000000;
  padding: 8px;
  font-size: 11px;
  text-align: center;
}

.theme-dark .btn-toggle {
  background: #111111;
  border-color: #666666;
  color: #eeeeee;
}

.btn-toggle.active {
  background: #000000;
  color: #ffffff;
}

.theme-dark .btn-toggle.active {
  background: #eeeeee;
  color: #111111;
}

.palette-list {
  max-height: 340px;
}

.palette-btn {
  border: 1px solid #000000;
  background: #ffffff;
  color: #000000;
  padding: 10px;
  margin-bottom: 8px;
}

.theme-dark .palette-btn {
  background: #111111;
  border-color: #666666;
  color: #eeeeee;
}

.palette-btn.active {
  background: #000000;
  color: #ffffff;
}

.theme-dark .palette-btn.active {
  background: #eeeeee;
  color: #111111;
}

.palette-name-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 8px;
}

.palette-count {
  font-size: 11px;
  opacity: 0.75;
}

.palette-preview-dots {
  display: flex;
  flex-wrap: wrap;
  gap: 1px;
  width: 100%;
}

.dot {
  width: 10px;
  height: 10px;
  border: 1px solid rgba(0, 0, 0, 0.1);
}

.theme-dark .dot {
  border: 0.5px solid #ffffff;
}

.palette-btn.active .dot {
  border: 0.5px solid #ffffff;
}

.theme-dark .palette-btn.active .dot {
  border: 0.5px solid #000000;
}

.action-btn {
  width: 100%;
  background: #000000;
  color: #ffffff;
  border: 2px solid #000000;
  padding: 12px;
  font-weight: 800;
  text-align: center;
}

.theme-dark .action-btn {
  background: #eeeeee;
  color: #111111;
  border-color: #666666;
}

.action-btn.disabled {
  opacity: 0.5;
}

.canvas-container {
  background: #f5f5f5;
  border: 2px dashed #000000;
  padding: 20px;
  display: flex;
  justify-content: center;
  align-items: center;
  width: 100%;
  height: 100%;
  position: relative;
  min-height: 300px;
  z-index: 1;
}

.theme-dark .canvas-container {
  background: #1a1a1a;
  border-color: #666666;
}

.main-canvas {
  display: block;
  opacity: 0;
  pointer-events: none;
  position: relative;
  z-index: 1;
  width: auto;
  height: auto;
  max-width: 100%;
  max-height: 100%;
  image-rendering: pixelated;
  image-rendering: -moz-crisp-edges;
  image-rendering: crisp-edges;
}

.main.has-image .main-canvas {
  opacity: 1;
  pointer-events: auto;
}

.main-canvas.is-hidden,
.main.has-image .main-canvas.is-hidden {
  opacity: 0;
  pointer-events: none;
  visibility: hidden;
}

.empty-hint {
  position: absolute;
  left: 0;
  right: 0;
  text-align: center;
  font-size: 12px;
  opacity: 0.7;
}

.close-btn {
  position: absolute;
  top: 8px;
  right: 8px;
  width: 32px;
  height: 32px;
  background: #ffffff;
  border: 2px solid #000000;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  line-height: 0;
  font-size: 0;
  color: #000000;
  opacity: 0;
  pointer-events: none;
  z-index: 100;
  transition: opacity 0.25s ease-out;
}

.close-btn-icon {
  position: relative;
  width: 16px;
  height: 16px;
}

.close-btn-line {
  position: absolute;
  top: 50%;
  left: 50%;
  width: 16px;
  height: 2px;
  background: currentColor;
  border-radius: 1px;
  transform-origin: center;
}

.close-btn-line.line-a {
  transform: translate(-50%, -50%) rotate(45deg);
}

.close-btn-line.line-b {
  transform: translate(-50%, -50%) rotate(-45deg);
}

.theme-dark .close-btn {
  background: #111111;
  border-color: #eeeeee;
  color: #eeeeee;
}

.close-btn.enabled {
  pointer-events: auto;
}

.close-btn.shown {
  opacity: 0.9;
}

.close-btn.is-hidden {
  opacity: 0;
  pointer-events: none;
  visibility: hidden;
  transition: none;
}

.fullscreen-modal {
  position: fixed;
  inset: 0;
  z-index: 10000;
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 0;
  overflow: hidden;
  visibility: hidden;
  pointer-events: none;
  transition: visibility 0s linear 260ms;
  cursor: zoom-out;
}

.fullscreen-modal.active,
.fullscreen-modal.closing {
  visibility: visible;
  pointer-events: auto;
  transition: visibility 0s linear 0s;
}

.fullscreen-backdrop {
  position: absolute;
  inset: 0;
  background-color: rgba(0, 0, 0, 0.82);
  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);
  opacity: 0;
  will-change: opacity, backdrop-filter;
  transition: opacity 260ms cubic-bezier(0.16, 1, 0.3, 1);
}

.page.is-ipad .fullscreen-backdrop {
  backdrop-filter: none;
  -webkit-backdrop-filter: none;
  will-change: opacity;
}

.fullscreen-modal.active .fullscreen-backdrop {
  opacity: 1;
}

.fullscreen-modal.closing .fullscreen-backdrop {
  opacity: 0;
}

.fullscreen-stage {
  position: relative;
  z-index: 1;
  width: 100%;
  height: 100%;
}

.fullscreen-image {
  position: absolute;
  left: 0;
  top: 0;
  object-fit: contain;
  display: block;
  image-rendering: pixelated;
  image-rendering: -moz-crisp-edges;
  image-rendering: crisp-edges;
  transform-origin: top left;
  transition: transform 90ms ease-out;
  will-change: transform;
}

.fullscreen-modal.animating .fullscreen-image {
  transition: transform 260ms cubic-bezier(0.16, 1, 0.3, 1);
}

.hidden-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
  width: 1px;
  height: 1px;
}

.offscreen-canvas {
  position: fixed;
  left: -9999px;
  top: -9999px;
}

@media (max-width: 768px) {
  .page {
    display: block;
    overflow: hidden;
    height: 100vh;
    position: fixed;
    width: 100%;
    top: 0;
    left: 0;
    max-width: none;
    overflow-x: hidden;
  }

  .safe-top-mask {
    display: block;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    height: var(--safe-top, env(safe-area-inset-top));
    background: #ffffff;
    z-index: 150;
    pointer-events: none;
  }

  .theme-dark .safe-top-mask {
    background: #111111;
  }

  .header {
    position: fixed;
    top: var(--safe-top, env(safe-area-inset-top));
    left: 0;
    right: 0;
    z-index: 200;
    padding: 10px var(--nav-pad-right, 20px) 10px var(--nav-pad-left, 20px);
    transform: translateY(-100%);
    transition: transform 0.3s ease-out;
  }

  .header.visible {
    transform: translateY(0);
  }

  .main {
    display: flex;
    flex-direction: column;
    padding: 0;
    gap: 0;
    height: 100vh;
    overflow: hidden;
    position: relative;
  }

  .preview-area {
    display: flex;
    position: fixed;
    top: calc(var(--safe-top, env(safe-area-inset-top)) + var(--preview-shift, 0px));
    left: 0;
    right: 0;
    z-index: 100;
    border-bottom: 2px solid #000000;
    padding: 8px;
    box-sizing: border-box;
    background: #ffffff;
    height: var(--preview-h, 40vh);
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.16s ease-out;
    will-change: opacity;
  }

  .preview-area.layout-anim {
    transition: opacity 0.16s ease-out, transform 0.35s cubic-bezier(0.2, 0, 0.2, 1);
    will-change: transform, opacity;
  }

  .main.has-image .preview-area {
    opacity: 1;
    pointer-events: auto;
  }

  .main.has-image .preview-area.is-hidden {
    opacity: 0;
    pointer-events: none;
    visibility: hidden;
  }

  .theme-dark .main.has-image .preview-area {
    border-bottom-color: #666666;
    background: #111111;
  }

  .main.has-image .canvas-container {
    min-height: 0;
    height: 100%;
    width: 100%;
    padding: 0;
    background: transparent;
    border: none;
    align-items: center;
  }

  .main.has-image .main-canvas {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
  }

  .close-btn.enabled {
    pointer-events: auto;
  }

  .close-btn.shown {
    opacity: 0.9;
  }

  .controls {
    overflow-y: auto;
    overflow-x: hidden;
    padding: 15px;
    padding-bottom: 0;
    flex: 1;
    position: relative;
    box-sizing: border-box;
    transition: none;
  }

  .controls-inner.layout-anim {
    transition: transform 0.35s cubic-bezier(0.2, 0, 0.2, 1);
    will-change: transform;
  }

  .controls .panel:first-child {
    margin-top: 15px;
  }

  .bottom-spacer {
    width: 100%;
    flex-shrink: 0;
  }

  .palette-list {
    max-height: 200px;
  }

  .palette-btn {
    padding: 12px 10px;
  }
}
